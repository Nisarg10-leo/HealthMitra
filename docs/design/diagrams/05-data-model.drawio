  <diagram id="05-data-model" name="HealthMitra v2 - Data Model">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <mxCell id="t-title" value="Data Model (server/sql/schema.sql · mirrored by data/memoryStore.js)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t-sub" value="Every patient-scoped table hangs off users(id). Access is decided by patient_caregiver_links.permission_level." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1200" height="22" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;id UUID PK&lt;br&gt;name · email UNIQUE · phone&lt;br&gt;role: patient | caregiver&lt;br&gt;password_hash (scrypt)&lt;br&gt;preferred_language en | hi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="links" value="&lt;b&gt;patient_caregiver_links&lt;/b&gt;&lt;br&gt;id PK&lt;br&gt;patient_id FK → users&lt;br&gt;caregiver_id FK → users&lt;br&gt;permission_level: view | edit&lt;br&gt;invite_code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="meds" value="&lt;b&gt;medications&lt;/b&gt;&lt;br&gt;id PK · patient_id FK&lt;br&gt;name · dosage · color&lt;br&gt;times TIME[] · frequency_per_day&lt;br&gt;start_date · end_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="330" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="dose" value="&lt;b&gt;dose_logs&lt;/b&gt;&lt;br&gt;id PK · medication_id FK&lt;br&gt;scheduled_time&lt;br&gt;status: pending|taken|skipped|missed&lt;br&gt;responded_at · response_method&lt;br&gt;reminder_sent_at · missed_alert_sent_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="560" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="sos" value="&lt;b&gt;sos_events&lt;/b&gt;&lt;br&gt;id PK · patient_id FK&lt;br&gt;triggered_at · latitude · longitude&lt;br&gt;status: active|acknowledged|resolved&lt;br&gt;updated_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="alerts" value="&lt;b&gt;alerts&lt;/b&gt;&lt;br&gt;id PK · patient_id FK&lt;br&gt;type: missed-dose | sos | info&lt;br&gt;message · created_at&lt;br&gt;read_by [user ids]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="520" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="notif" value="&lt;b&gt;notifications&lt;/b&gt;&lt;br&gt;id PK · user_id FK · patient_id FK&lt;br&gt;type · title · body&lt;br&gt;channel (in-app / push)&lt;br&gt;created_at · read_at&lt;br&gt;alert_id / dose_log_id (context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="doctors" value="&lt;b&gt;doctors&lt;/b&gt;&lt;br&gt;id PK · patient_id FK&lt;br&gt;name · specialty · phone · notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E0B25B;fontColor=#5A431A;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="330" width="300" height="100" as="geometry"/></mxCell>
