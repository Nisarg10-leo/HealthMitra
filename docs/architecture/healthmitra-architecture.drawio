  <diagram id="healthmitra-architecture" name="HealthMitra Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="HealthMitra - Local to Production Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#20343A;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Voice-friendly medication adherence and family caregiver support" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#65767B;" vertex="1" parent="1"><mxGeometry x="60" y="78" width="740" height="24" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;Patient (elderly)&lt;br&gt;Caregiver (family)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#E3B95A;fontColor=#4B3D1B;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="65" y="270" width="180" height="115" as="geometry"/></mxCell>
        <mxCell id="frontend" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;React + Vite&lt;br&gt;i18next: English / Hindi&lt;br&gt;Accessible large controls&lt;br&gt;Browser speech + geolocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FF;strokeColor=#7385DB;fontColor=#293B8B;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="265" height="175" as="geometry"/></mxCell>
        <mxCell id="backend" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;Node.js + Express REST&lt;br&gt;Role-aware access checks&lt;br&gt;Medication CRUD, SOS, contacts&lt;br&gt;Voice intent integration seam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EF;strokeColor=#53A77C;fontColor=#245B42;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="205" width="285" height="190" as="geometry"/></mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;Reliable Scheduler&lt;/b&gt;&lt;br&gt;node-cron (every minute)&lt;br&gt;Create reminder events&lt;br&gt;Mark missed after 15 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F4;strokeColor=#73A88A;fontColor=#285D45;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="710" y="465" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="notifications" value="&lt;b&gt;Notification Adapter&lt;/b&gt;&lt;br&gt;In-app notification log&lt;br&gt;FCM / SMS replacement seam&lt;br&gt;Missed dose + SOS alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EF;strokeColor=#D7786D;fontColor=#873A34;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="465" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="database" value="&lt;b&gt;Data / Cache&lt;/b&gt;&lt;br&gt;PostgreSQL 16&lt;br&gt;users, links, medications&lt;br&gt;dose_logs, sos_events&lt;br&gt;doctors, chemists, notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7D8A8E;fontColor=#344246;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="205" width="260" height="190" as="geometry"/></mxCell>
        <mxCell id="containers" value="&lt;b&gt;Containerization&lt;/b&gt;&lt;br&gt;Dockerfiles: client + API&lt;br&gt;docker-compose: client + API + Postgres&lt;br&gt;Health checks / environment config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F8;strokeColor=#529FB4;fontColor=#1F5260;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="330" y="620" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="deployment" value="&lt;b&gt;Deployment / Infrastructure&lt;/b&gt;&lt;br&gt;Frontend: Vercel / Netlify&lt;br&gt;API + DB: Railway / Render&lt;br&gt;Secrets: database URL, FCM, Groq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFA;strokeColor=#9276C7;fontColor=#4B3975;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="620" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid arrow = request/data flow&lt;br&gt;Dashed arrow = event/notification flow&lt;br&gt;Optional external services are shown as replaceable seams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD6D2;fontColor=#5E6E72;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="1230" y="655" width="280" height="115" as="geometry"/></mxCell>
