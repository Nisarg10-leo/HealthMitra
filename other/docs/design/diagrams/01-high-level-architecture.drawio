        <mxCell id="middleware" value="&lt;b&gt;middleware/&lt;/b&gt;&lt;br&gt;requireUser (x-user-id -&amp;gt; req.actor)&lt;br&gt;errorHandler (HttpError -&amp;gt; {error})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F0;strokeColor=#3E9A80;fontColor=#1C4A3D;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="950" y="175" width="245" height="78" as="geometry"/></mxCell>
        <mxCell id="services" value="&lt;b&gt;services/  (business rules)&lt;/b&gt;&lt;br&gt;access · auth · link · medication · dose · adherence&lt;br&gt;notification · sos · contact · symptom · voiceIntent&lt;br&gt;Plain async functions - no Express, no storage details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F0;strokeColor=#3E9A80;fontColor=#1C4A3D;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="685" y="283" width="510" height="96" as="geometry"/></mxCell>
