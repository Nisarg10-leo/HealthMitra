        <mxCell id="t-title" value="HealthMitra v2 - High-Level Architecture (Layered Client-Server)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t-sub" value="Presentation, application, and data layers are independently replaceable. Solid = request/response · Dashed = event / notification / external seam" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="22" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;Patient (elderly)&lt;br&gt;Caregiver (family)&lt;br&gt;Phone or laptop browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#E77B47;fontColor=#6B2E12;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="150" height="120" as="geometry"/></mxCell>
        <mxCell id="features" value="&lt;b&gt;features/*&lt;/b&gt;&lt;br&gt;auth · today · dashboard · medications&lt;br&gt;history · alerts · symptoms · contacts&lt;br&gt;sos · linking (one folder per screen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FF;strokeColor=#6B7FD7;fontColor=#22336E;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="265" y="175" width="290" height="88" as="geometry"/></mxCell>
