        <mxCell id="g-server" value="&lt;b&gt;APPLICATION LAYER · Express API (server/src)&lt;/b&gt;&lt;br&gt;Node.js 24 · REST/JSON · node-cron" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9CED6;fontColor=#4B5563;fontSize=14;align=left;verticalAlign=top;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="560" height="560" as="geometry"/></mxCell>
